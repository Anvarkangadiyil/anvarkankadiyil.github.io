# Contact form (Resend) — copy to .env.local and fill in.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to "Portfolio <onboarding@resend.dev>", which only delivers
# to your Resend account email. Use an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Optional. Defaults to siteConfig.email in lib/constants.ts
CONTACT_TO_EMAIL=
